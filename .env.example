# Entorno
NODE_ENV=development
PORT=3000

# CORS: orígenes separados por coma (web 4200, móvil web 4201)
CORS_ORIGIN=http://localhost:4200,http://localhost:4201,http://localhost:8100

# Base de datos
# DATABASE_URL=postgres://canchalibre:canchalibre@localhost:5432/canchalibre
DB_HOST=localhost
DB_PORT=5432
DB_USER=canchalibre
DB_PASSWORD=canchalibre
DB_NAME=canchalibre
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# JWT (cambiar en producción)
JWT_SECRET=canchalibre-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Pagos (sandbox)
PAYMENTS_PROVIDER=sandbox
PAYMENTS_WEBHOOK_SECRET=canchalibre-dev-webhook

# Semilla
SEED_DATABASE=true
SEED_DEMO_DATA=true
