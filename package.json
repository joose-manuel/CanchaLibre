{
  "name": "canchalibre",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "CanchaLibre — plataforma de reserva de canchas deportivas (Cali, Colombia)",
  "scripts": {
    "back": "nx serve api",
    "front": "nx serve front",
    "movil": "nx serve movil",
    "movil:serve": "nx serve movil",
    "movil:android": "nx run movil:android",
    "movil:sync": "nx run movil:sync",
    "movil:open": "nx run movil:open",
    "movil:add:android": "nx run movil:add:android",
    "build": "nx run-many -t build --projects=api,front,movil",
    "build:api": "nx build api --configuration=production",
    "build:front": "nx build front --configuration=production",
    "build:movil": "nx build movil --configuration=production",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:seed": "ts-node --project apps/api/tsconfig.app.json -r tsconfig-paths/register apps/api/src/database/seed.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d apps/api/src/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d apps/api/src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d apps/api/src/database/data-source.ts migration:revert"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "9.0.9",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "compression": "1.8.1",
    "dotenv": "17.4.1",
    "helmet": "8.1.0",
    "ionicons": "8.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "0.3.31",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.25",
    "@angular-devkit/schematics": "21.2.25",
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.1",
    "@nestjs/schematics": "11.1.0",
    "@nx/angular": "23.3.1",
    "@nx/eslint": "23.3.1",
    "@nx/eslint-plugin": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/nest": "23.3.1",
    "@nx/node": "23.3.1",
    "@nx/web": "23.3.1",
    "@nx/webpack": "23.3.1",
    "@nx/workspace": "23.3.1",
    "@schematics/angular": "21.2.25",
    "@swc/helpers": "~0.5.18",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "@types/qrcode": "1.5.6",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "nx": "23.3.1",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "7.2.3"
  }
}
